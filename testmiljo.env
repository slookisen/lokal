# testmiljo.env — settings for the LOCAL test environment (npm run testmiljo).
#
# Read by scripts/testmiljo/launch.ts. Independent of production: nothing here
# is read by Fly, and production never reads this file. NO secrets, NO API keys:
# the launcher also strips every inherited variable whose name looks like a
# credential (…KEY, …TOKEN, …SECRET, …PASS…, SMTP_*, …PAT) before it applies
# this file, so LLM calls, SMTP and other paid/remote APIs stay off even when
# your shell has them set. Format: KEY=VALUE, one per line, # starts a comment.
# Each key appears once (the launcher would silently keep the last one).

# Not production, not the test suite (NODE_ENV=test switches on test-only seams).
NODE_ENV=development

# Fixed port, bound to this machine only.
PORT=3100
HOST=127.0.0.1
# Rett fra Bonden's own local name (see docs/testmiljo.md, «Adresser»): links
# built from BASE_URL then stay on the host that holds the owner's session.
BASE_URL=http://rettfrabonden.localhost:3100

# The three seeded databases (relative to the repo root; must stay in .testmiljo/).
DB_PATH=.testmiljo/lokal.db
DENTAL_DB_PATH=.testmiljo/dental.db
EXPERIENCES_DB_PATH=.testmiljo/experiences.db

# Serve the Finn-tannlege and Opplevagent verticals too (they are off unless 1).
ENABLE_DENTAL=1
ENABLE_EXPERIENCES=1

# ════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS — every flag the app code reads (src/**/*.ts, not tests).
#
# Rule: the PRODUCTION value, except background jobs that reach the network,
# call an LLM, send mail or rewrite data on a timer: those are off here even
# where prod has them on (marked «# prod: … — off here because …»).
# The production value is known only for flags in fly.toml [env]. A flag that
# is not there is either unset in prod or set as a Fly secret, which this repo
# cannot see: it carries the code's default here, written out explicitly.
# What is under test has its own block at the end («UNDER TEST»).
#
# npm test (src/testmiljo/testmiljo.test.ts, f1-f4) fails when a flag in the
# code is missing here, or a flag differs from fly.toml [env] without being on
# the exceptions list there. A PR that adds a flag adds it here.
# ════════════════════════════════════════════════════════════════════════════

# ── Background jobs and schedulers ─────────────────────────────────────────
# Kill switches (1 = the job does not start). Code default: the job runs.
# Off here so the seeded data stays as seeded and nothing leaves the machine.
DISPATCH_TICK_DISABLED=1
RFB_DISABLE_URL_BACKFILL=1
RFB_DISABLE_AUTO_PRUNE=1
RFB_DISABLE_OFFSITE_BACKUP=1
RFB_DISABLE_DEBIO_SYNC=1
RFB_DISABLE_SALGSKANAL_SYNC=1
RFB_DISABLE_AGENTS_GEOCODE=1
RFB_DISABLE_POSTAL_BACKFILL=1
RFB_DISABLE_DENTAL_GEOCODE=1
RFB_DISABLE_EXPERIENCES_GEOCODE=1
RFB_DISABLE_BOOKING_FOLLOWUPS=1
RFB_DISABLE_ORDER_FOLLOWUPS=1
RFB_DISABLE_PAYMENT_MAINTENANCE=1
GARDSSALG_OUTREACH_DAILY_DISABLED=1
TRAFFIC_HISTORY_DISABLED=1
# Off-thread stats worker: not needed for a click-through copy.
OFFTHREAD_STATS_DISABLED=1
# default: on — off here because it is a 15-minute timer that deletes translations.
PROFILE_TRANSLATIONS_STALE_SWEEP_ENABLED=false
# default: on — off here because it fetches Search Console / Bing on a timer.
SEARCH_CONSOLE_FETCH_ENABLED=0
# Local only (no network, no data rewritten): code default.
EVENT_LOOP_MONITOR_DISABLED=0
WORKER_THREAD_NICE_DISABLED=0
ADMIN_ORDER_DAILY_SUMS_DISABLED=0

# Jobs and checks that are on in prod (fly.toml [env]).
# prod: 'true' — off here because the nightly enrichment fetches web pages and calls an LLM.
RFB_ENRICHMENT_NIGHTLY_ENABLED=false
# prod: '1' — off here because the verifier fetches producers' websites on a timer.
VERIFIER_SCHEDULER_ENABLED=0
# prod: 'true' — off here because the catalog sync fetches web shops on a timer.
CATALOG_SYNC_SCHEDULER_ENABLED=false
# prod: 'true' — off here because it pings IndexNow (search engines) on a timer.
INDEXNOW_SYNC_ENABLED=false
# prod: 'true' — off here because it starts a headless browser against websites
# (a child process: the outbound guard covers the main process only).
RFB_WD_HEADLESS_FALLBACK_ENABLED=false
# prod: 'true' — off here for the same reason (headless browser).
HOMEPAGE_PROVENANCE_HEADLESS_FALLBACK_ENABLED=false
# prod: 'true' — off here because the second-line check calls an LLM.
RFB_SECOND_LINE_VERIFICATION_ENABLED=false
# prod: 'true' — off here because the gårdssalg second-line check calls an LLM.
GS_SECOND_LINE_VERIFICATION_ENABLED=false
# default: on — off here because it writes visit text with an LLM.
GARDSSALG_VISIT_LLM_ENABLED=false

# Jobs that are off by code default (not in fly.toml).
DENTAL_VERIFIER_SCHEDULER_ENABLED=0
DENTAL_TRIAGE_JOB_ENABLED=false
DENTAL_TRIAGE_JUDGEMENT_JOB_ENABLED=false
EXPERIENCE_CONTENT_JUDGEMENT_JOB_ENABLED=false
EXPERIENCE_FACTS_PROPOSALS_JOB_ENABLED=false
EXPERIENCE_ORGNR_JOB_ENABLED=false
EXPERIENCE_PROPOSALS_JOB_ENABLED=false
GARDSSALG_CONTENT_REFRESH_JOB_ENABLED=false
GARDSSALG_VISIT_PROPOSALS_JOB_ENABLED=false
GARDSSALG_WEBSITE_JUDGEMENT_JOB_ENABLED=false
GARDSSALG_WEBSITE_REVIEW_QUEUE_PARK_JOB_ENABLED=false
GARDSSALG_WEBSITE_VERIFICATION_JOB_ENABLED=false
RFB_MARKETING_PLATFORM_ENABLED=0
RETENTION_JOB_ENABLED=false
# dry_run = count only, nothing deleted (code default).
PRIVACY_RETENTION_MODE=dry_run
CART_CONTACT_SWEEP_LIVE=false
GARDSSALG_GUEST_CONTACT_SWEEP_LIVE=false
PROFILE_TRANSLATIONS_AUTO_REPUBLISH_ENABLED=false
PRODUCT_AUTO_SYNC_ENABLED=0
RFB_DEBIO_CERT_DETAIL_SYNC=0
RFB_DEBIO_REGISTER_SYNC=0
CS_WATCHDOG_ENABLED=0
CS_DAILY_DIGEST_ENABLED=0
CS_INBOUND_SERVER_INGEST_ENABLED=0
DISPATCH_FIRE_MODE=shadow

