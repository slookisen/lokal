# ── UNDER TEST: what is being tried out in the test environment ─────────────
# Not production values. These show the owner dashboards for the seeded
# owners: the RFB owner portal (/eier) with its dashboard and the orderability
# card, and the Opplevagent gårdssalg owner dashboard with the address form.
OWNER_DASHBOARD_ENABLED=1
OWNER_ORDERABILITY_PORTAL_ENABLED=1
OA_OWNER_FEATURES_ENABLED=1
GARDSSALG_OWNER_DASHBOARD_ENABLED=pilot
GARDSSALG_OWNER_ADDRESS_EDIT_ENABLED=pilot
# The seeded owners (fixed ids from scripts/testmiljo/seed.ts) as <vertical>:<id>:
# RFB Nyeier, Varebod, Nettside; gårdssalg Testbryggeriet Stille, Testmjøderiet Travelt.
OWNER_FEATURES_ALLOWED_SUBJECTS=rfb:00000000-0000-4000-8001-000000000002,rfb:00000000-0000-4000-8001-000000000003,rfb:00000000-0000-4000-8001-000000000004,gardssalg:00000000-0000-4000-8006-000000000002,gardssalg:00000000-0000-4000-8006-000000000003

# ── src/testmiljo: owner login without e-mail, e-mail outbox, local names ──
# The one switch for the test-only code. In production it is ignored (and
# logged). Here the app refuses to start with any value but 1, or with mail
# credentials present.
TESTMILJO=1
# Outbound connections are blocked unless the host is listed here
# (comma-separated, a leading dot allows subdomains). Empty: nothing leaves.
TESTMILJO_ALLOW_OUTBOUND=
# The per-IP rate limits are skipped (every local request is 127.0.0.1).
# Set to on to test the limits themselves.
TESTMILJO_RATE_LIMITS=

# The contact forms verify a Cloudflare Turnstile token; there is no secret here.
SKIP_TURNSTILE=true
# Sends flagged as test sends go to this address (captured in the outbox like all mail).
TEST_SEND_REDIRECT_EMAIL=testsending@testmiljo.invalid
# /health compares memory with this limit; the default (512) reads as critical locally.
MEMORY_LIMIT_MB=2048
