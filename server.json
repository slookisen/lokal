{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.slookisen/lokal-mcp",
  "description": "Norwegian local-food MCP: 1,500+ farms, shops, markets + umbrellas (Bondens marked, Hanen, REKO).",
  "websiteUrl": "https://rettfrabonden.com",
  "repository": {
    "url": "https://github.com/slookisen/lokal",
    "source": "github",
    "subfolder": "mcp-server"
  },
  "version": "0.5.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lokal-mcp",
      "version": "0.5.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LOKAL_URL",
          "description": "Override API base URL (default: https://rettfrabonden.com)",
          "required": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://rettfrabonden.com/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://server.smithery.ai/@slookisen/rettfrabonden"
    }
  ]
}
