{
  "name": "rfb-intl-staging",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Fly.io staging service for SE/DK producer candidates. Outside prod, never public (dev-request A2A 2026-10-13-se-batch-profiler-staging).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
